# Copy to .env and change AGENT_API_TOKEN before starting the API.
# Never commit .env.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
MODEL_CONTEXT_TOKENS=32768
SYSTEM_PROMPT_PATH=config/system_prompt.md
AGENT_NAME=Local AI Agent
AGENT_MISSION=Execute approved local tasks with evidence-based, policy-enforced tool use.
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
DISPATCH_ENABLED=false
DISPATCH_MAX_WORKERS=1
DISPATCH_CLAIM_POLL_SECONDS=1.0
DISPATCH_CLAIM_JITTER_SECONDS=0.25
DISPATCH_WORKER_STALE_SECONDS=120
DISPATCH_RECOVERY_SWEEP_SECONDS=30
DISPATCH_MAX_ATTEMPTS=1
DISPATCH_HEARTBEAT_EVENT_SAMPLE_SECONDS=30
DELEGATION_MAX_UNITS=5
DELEGATION_MAX_UNIT_TOOL_CALLS=3
DELEGATION_MAX_UNIT_MODEL_TURNS=3
DELEGATION_MAX_RETRIES=0

AGENT_API_TOKEN=replace-with-a-long-random-token
WORKSPACE_ROOT=./workspace
SQLITE_PATH=./workspace/.agent/agent.db

DEFAULT_MAX_TOOL_CALLS=30
DEFAULT_MAX_RUNTIME_SECONDS=600
DEFAULT_MAX_SHELL_EXECUTIONS=10
DEFAULT_MAX_RETRIES=3

CONTEXT_RESERVE_TOKENS=500
RECENT_TOOL_RESULTS=3
RECENT_CONVERSATION=5

DOCKER_BINARY=docker
DOCKER_SANDBOX_IMAGE=local-ai-agent-sandbox:latest
DOCKER_SANDBOX_NETWORK=none
DOCKER_SANDBOX_MEMORY=256m
DOCKER_SANDBOX_CPUS=0.5
DOCKER_SANDBOX_PIDS_LIMIT=64
DOCKER_SANDBOX_USER=10001:10001
DOCKER_SANDBOX_TMPFS_SIZE=16m
DOCKER_SANDBOX_READ_ONLY_ROOT=true

FILESYSTEM_MAX_READ_BYTES=65536
FILESYSTEM_MAX_LIST_ENTRIES=1000

RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=5
CONTEXT_CHARS_PER_TOKEN=4
